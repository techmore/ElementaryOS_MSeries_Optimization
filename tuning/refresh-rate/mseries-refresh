#!/usr/bin/python3
"""Switch the built-in panel's refresh rate with the power source: battery_hz on battery, ac_hz on AC.

  mseries-refresh --status        show current mode, power source and the configured targets
  mseries-refresh --once          apply the right rate now and exit
  mseries-refresh                 apply now, then follow UPower's OnBattery changes (the user service does this)
  mseries-refresh --dynamic       also drop to low_hz after idle_seconds without input and return to the active rate on input
                                  (off unless dynamic = true or --dynamic; a mode switch blanks the screen briefly, so keep
                                  the hysteresis conservative; true variable refresh is not available on this stack)

Config (optional) ~/.config/mseries/refresh.conf:  battery_hz = 60   ac_hz = 120   enabled = true
                                                   dynamic = false   idle_seconds = 15   low_hz = 60   min_dwell_seconds = 20
Uses Mutter's DisplayConfig with a temporary configuration (method 1), so a restart returns to the saved layout.
Measured (2026-10-15, 21% brightness, battery discharging): 60 Hz drew ~2 W (15%) less than 120 Hz.
"""
import sys
import time
from pathlib import Path

CONFIG = Path.home() / '.config/mseries/refresh.conf'
DEFAULTS = {'battery_hz': 60.0, 'ac_hz': 120.0, 'enabled': True, 'dynamic': False,
            'idle_seconds': 15.0, 'low_hz': 60.0, 'min_dwell_seconds': 20.0}


def load_config(path=CONFIG):
    config = dict(DEFAULTS)
    try:
        for line in path.read_text().splitlines():
            line = line.split('#', 1)[0]
            if '=' not in line:
                continue
            key, value = (part.strip() for part in line.split('=', 1))
            if key in ('battery_hz', 'ac_hz', 'idle_seconds', 'low_hz', 'min_dwell_seconds'):
                config[key] = float(value)
            elif key in ('enabled', 'dynamic'):
                config[key] = value.lower() in ('1', 'true', 'yes', 'on')
    except (OSError, ValueError):
        pass
    return config


def pick_mode(modes, current, hz):
    """Mode with the same size as `current` whose refresh rate is closest to `hz`. Modes: (id, w, h, refresh, ...)."""
    same_size = [m for m in modes if m[1] == current[1] and m[2] == current[2]]
    return min(same_size, key=lambda m: abs(m[3] - hz))


def decide_dynamic(config, on_battery, idle_ms, current_hz, seconds_since_change):
    """Refresh rate to use now, or None to leave it. Idle past idle_seconds -> low_hz; input -> the source's rate.
    Never switches more often than min_dwell_seconds, so a mode-switch blank cannot flicker the screen."""
    active = target_hz(config, on_battery)
    wanted = min(active, config['low_hz']) if idle_ms >= config['idle_seconds'] * 1000 else active
    if abs(wanted - current_hz) < 1.0 or seconds_since_change < config['min_dwell_seconds']:
        return None
    return wanted


def target_hz(config, on_battery):
    return config['battery_hz'] if on_battery else config['ac_hz']


def main():
    from gi.repository import Gio, GLib
    bus = Gio.bus_get_sync(Gio.BusType.SESSION)
    system = Gio.bus_get_sync(Gio.BusType.SYSTEM)

    def display(method, args, sig):
        return bus.call_sync('org.gnome.Mutter.DisplayConfig', '/org/gnome/Mutter/DisplayConfig',
                             'org.gnome.Mutter.DisplayConfig', method, args, GLib.VariantType(sig), 0, 5000)

    def on_battery():
        reply = system.call_sync('org.freedesktop.UPower', '/org/freedesktop/UPower', 'org.freedesktop.DBus.Properties',
                                 'Get', GLib.Variant('(ss)', ('org.freedesktop.UPower', 'OnBattery')),
                                 GLib.VariantType('(v)'), 0, 5000)
        return reply.unpack()[0]

    def state():
        serial, monitors, logicals, _ = display('GetCurrentState', None,
            '(ua((ssss)a(siiddada{sv})a{sv})a(iiduba(ssss)a{sv})a{sv})').unpack()
        monitor = next(m for m in monitors if m[0][0] == 'eDP-1')
        current = next(m for m in monitor[1] if m[6].get('is-current'))
        return serial, monitor, logicals, current

    def switch_to(serial, monitor, logicals, wanted):
        logical = next(l for l in logicals if any(c[0] == 'eDP-1' for c in l[5]))
        layout = [(logical[0], logical[1], logical[2], logical[3], logical[4], [('eDP-1', wanted[0], {})])]
        display('ApplyMonitorsConfig', GLib.Variant('(uua(iiduba(ssa{sv}))a{sv})', (serial, 1, layout, {})), '()')

    def apply(report_only=False):
        config = load_config()
        battery = on_battery()
        serial, monitor, logicals, current = state()
        wanted = pick_mode(monitor[1], current, target_hz(config, battery))
        print('source=%s current=%.3f Hz target=%.3f Hz enabled=%s' % (
            'battery' if battery else 'AC', current[3], wanted[3], config['enabled']), flush=True)
        if report_only or not config['enabled'] or wanted[0] == current[0]:
            return
        switch_to(serial, monitor, logicals, wanted)

    changed = {'at': time.monotonic() - 3600}

    def dynamic_tick():
        config = load_config()
        if not config['enabled']:
            return True
        idle_ms = bus.call_sync('org.gnome.Mutter.IdleMonitor', '/org/gnome/Mutter/IdleMonitor/Core',
                                'org.gnome.Mutter.IdleMonitor', 'GetIdletime', None, GLib.VariantType('(t)'), 0, 2000).unpack()[0]
        serial, monitor, logicals, current = state()
        hz = decide_dynamic(config, on_battery(), idle_ms, current[3], time.monotonic() - changed['at'])
        if hz is not None:
            switch_to(serial, monitor, logicals, pick_mode(monitor[1], current, hz))
            changed['at'] = time.monotonic()
            print('dynamic: idle %.0f s -> %.0f Hz' % (idle_ms / 1000, hz), flush=True)
        return True

    if '--status' in sys.argv:
        apply(report_only=True)
        return
    apply()
    if '--once' in sys.argv:
        return
    system.signal_subscribe('org.freedesktop.UPower', 'org.freedesktop.DBus.Properties', 'PropertiesChanged',
                            '/org/freedesktop/UPower', None, Gio.DBusSignalFlags.NONE,
                            lambda *args: GLib.timeout_add_seconds(2, lambda: apply() or False), None)
    if '--dynamic' in sys.argv or load_config()['dynamic']:
        GLib.timeout_add_seconds(2, dynamic_tick)
    GLib.MainLoop().run()


if __name__ == '__main__':
    main()
